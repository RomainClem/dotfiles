export ZSH="$HOME/.oh-my-zsh"

#Aliases
alias wi="cd ~/WorkSpace/Repos/WebInterface"

#Theme
ZSH_THEME=""

#Plugins
# zsh-autocomplete cannot live in plugins=(): oh-my-zsh puts only a plugin's ROOT
# on fpath, runs compinit, and sources plugin.zsh last -- but the _autocomplete__*
# helpers sit in the plugin's Completions/ subdir, which plugin.zsh adds to fpath
# only at that final step, long after compinit stopped looking. The result is
# "command not found: _autocomplete__unambiguous" on every Tab. So put Completions/
# on fpath ourselves (before omz's compinit sees it) and source the plugin by hand.
fpath=($HOME/.oh-my-zsh/custom/plugins/zsh-autocomplete/Completions $fpath)
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
source $ZSH/oh-my-zsh.sh
source $HOME/.oh-my-zsh/custom/plugins/zsh-autocomplete/zsh-autocomplete.plugin.zsh

#Exports
# Automatically set Windows host IP for WSL
export WINDOWS_HOST_IP=$(grep -m 1 nameserver /etc/resolv.conf | awk '{print $2}')

# export APIProxy__Target="https://${WINDOWS_HOST_IP}:7120"
# Only trust the ASP.NET dev-cert store if it exists, otherwise tools that read
# SSL_CERT_DIR (mise, curl) warn on every invocation.
if [ -d "$HOME/.aspnet/dev-certs/trust" ]; then
    export SSL_CERT_DIR=$HOME/.aspnet/dev-certs/trust:/usr/lib/ssl/certs
fi

# zsh options
setopt hist_ignore_all_dups

#Star Ship
eval "$(starship init zsh)"

# bun -- provided by mise, so ~/.bun/bin is deliberately NOT on PATH; having it
# here would shadow the mise-pinned bun with the old self-upgrading curl install.
# ~/.bun is kept only for its completion script.
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

#Claude Code
export CLAUDE_CODE_TMUX_TRUECOLOR=1

# Local bin
[ -s "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# mise (runtime & tool manager, e.g. neovim, node)
# Interactive shells get the real install dirs prepended ahead of the shims that
# .zshenv puts on PATH. Non-interactive shells never read this file -- see .zshenv.
command -v mise &>/dev/null && eval "$(mise activate zsh)"

# Browser for CLIs that shell out to open a URL (rayfin login, gh auth, ...).
# WSL has no xdg-open, and rayfin's openBrowser fires exec() without checking the
# error, so an unset $BROWSER means sign-in hangs silently on the loopback wait.
# Must be a bare executable path -- rayfin interpolates it as a single quoted word.
if [ -x "/mnt/c/Program Files (x86)/Microsoft/Edge/Application/msedge.exe" ]; then
    export BROWSER="/mnt/c/Program Files (x86)/Microsoft/Edge/Application/msedge.exe"
fi

# gnome-keyring holds the rayfin token; WSL has no desktop login to unlock it, so
# do it on the first interactive shell after each WSL restart. The guard needs -f
# (comm is capped at 15 chars, "gnome-keyring-daemon" is 20, so -x never matches)
# and the [g] bracket so the pattern doesn't match this shell's own command line.
if [[ -o interactive ]] && ! pgrep -u "$USER" -f '[g]nome-keyring-daemon' >/dev/null; then
    read -rs "pw?Unlock keyring: "; echo
    printf '%s' "$pw" | gnome-keyring-daemon --unlock --components=secrets
    unset pw
fi
